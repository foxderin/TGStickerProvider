<resources>
    <!-- Base application theme. -->
    <style name="Theme.AppDefault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#006A6A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#9CF1F0</item>
        <item name="colorOnPrimaryContainer">#002020</item>
        <item name="colorSecondary">#4A6363</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#CCE8E7</item>
        <item name="colorOnSecondaryContainer">#051F1F</item>
        <item name="colorTertiary">#4B607C</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#D3E4FF</item>
        <item name="colorOnTertiaryContainer">#041C35</item>
        <item name="android:colorBackground">#F4FBFA</item>
        <item name="colorOnBackground">#161D1D</item>
        <item name="colorSurface">#F4FBFA</item>
        <item name="colorOnSurface">#161D1D</item>
        <item name="colorSurfaceBright">#F4FBFA</item>
        <item name="colorSurfaceDim">#D5DBDA</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerHighest">#DDE4E3</item>
        <item name="colorSurfaceInverse">#2B3231</item>
        <item name="colorOnSurfaceInverse">#ECF2F1</item>
        <item name="colorPrimaryInverse">#80D5D4</item>
        <item name="colorSurfaceVariant">#DAE5E4</item>
        <item name="colorOnSurfaceVariant">#3F4948</item>
        <item name="colorSurfaceContainerLow">#EFF5F4</item>
        <item name="colorSurfaceContainer">#E9EFEE</item>
        <item name="colorSurfaceContainerHigh">#E3EAE9</item>
        <item name="colorOutline">#6F7979</item>
        <item name="colorOutlineVariant">#BEC9C8</item>
        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>
        <item name="colorErrorContainer">#FFDAD6</item>
        <item name="colorOnErrorContainer">#410002</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.CornerSize15Percent" parent="">
        <item name="cornerSize">15%</item>
    </style>
    <style name="NoDisplay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <!-- 设置是否可滑动 -->
        <item name="android:windowIsFloating">true</item>
        <!-- 设置是否透明 -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- 无标题 -->
        <item name="android:windowNoTitle">true</item>
        <!-- 背景 -->
        <item name="android:background">@null</item>
        <!-- 窗口背景 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 是否变暗 -->
        <item name="android:backgroundDimEnabled">false</item>
        <!-- 点击空白部分activity不消失 -->
        <item name="android:windowCloseOnTouchOutside">true</item>
        <!-- 无标题 有的手机设置这行代码-->
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
</resources>